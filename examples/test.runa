struct Person {
    name,
    age,
}

func (p Person) greet() {
    print("Привет, меня зовут", p.name)
    print("Мне", p.age, "лет")
}

func factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

func main() {
    var x = 10
    y := 5
    
    print("--- Математика ---")
    print("x + y =", x + y)
    print("x * y =", x * y)
    print("x / y =", x / y)
    
    print("--- Логика и условия ---")
    flag := x > y && !(x == y)
    print("flag =", flag)
    
    if flag {
        print("x больше y")
    } else {
        print("x меньше или равен y")
    }
    
    print("--- Циклы ---")
    sum := 0
    i := 1
    for i <= 5 {
        sum = sum + i
        i = i + 1
    }
    print("Сумма от 1 до 5 =", sum)
    
    print("--- Функции ---")
    print("Факториал 5 =", factorial(5))
    
    print("--- Методы и структуры (Не ООП) ---")
    p := Person { name: "Костя", age: 19 }
    p.greet()
}

main()